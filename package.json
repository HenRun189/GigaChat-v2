{
  "name": "gigachat",
  "version": "4.0.0",
  "private": true,
  "description": "GigaChat – real-time PWA messenger",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm --filter @gigachat/web build && pnpm --filter @gigachat/server build",
    "start": "pnpm --filter @gigachat/server start",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @gigachat/server db:generate",
    "migrate:mysql": "pnpm --filter @gigachat/server migrate:mysql"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
