    "@fastify/websocket": "^11.0.0",
    "@gigachat/shared": "workspace:*",
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.16.0",
    "sharp": "^0.34.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
