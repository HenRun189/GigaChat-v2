# ---- GigaChat server configuration ----
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public origin of the app (used for secure cookies, CSRF checks and push links)
PUBLIC_URL=http://localhost:5173

# PostgreSQL connection string. REQUIRED for any real deployment.
# Leave empty only for local development: the server then uses an embedded
# PGlite database in DATA_DIR, which is convenient but not crash-safe
# (a hard kill can corrupt it; the server then moves it aside and starts fresh).
DATABASE_URL=
# DATABASE_URL=postgres://gigachat:gigachat@localhost:5432/gigachat

# Directory for uploads, the embedded database and generated keys
DATA_DIR=./data

# Web push (VAPID). Generate with: pnpm --filter @gigachat/server vapid
# If left empty in development, keys are generated once and stored in DATA_DIR.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Giphy API key for the GIF picker (client-side search)
GIPHY_API_KEY=

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Traefik)
TRUST_PROXY=0

# ---- Legacy MySQL migration (only for scripts/migrate-mysql.ts) ----
LEGACY_MYSQL_HOST=localhost
LEGACY_MYSQL_USER=webapp_user
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=chat
LEGACY_UPLOADS_DIR=./legacy/uploads
